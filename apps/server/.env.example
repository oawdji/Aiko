# LLM 配置（OpenAI 兼容端点，当前使用 DeepSeek）
# 第三方中转站：修改 LLM_BASE_URL 与 LLM_MODEL 即可，格式保持 OpenAI 兼容
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 数据目录（可选，默认为仓库根 data/；未来打包桌面应用时指向系统数据目录）
# DATA_DIR=

# 本地服务端口（默认 8787，仅监听 127.0.0.1）
PORT=8787
# 情绪引擎（rules-v1 = 词典规则；off = 关闭情绪更新，不产生状态事件）
EMOTION_ENGINE=rules-v1

# 语义检索 / 本地记忆(全部有默认值,可不配置)
# EMBEDDING_MODEL_NAME=BAAI/bge-base-zh-v1.5
# EMBEDDING_DEVICE=cpu
# MEMORY_DB_PATH=data/memory-vectors.db
# MEMORY_CHUNK_MAX_CHARS=500
# MEMORY_CHUNK_OVERLAP_SENTENCES=1
# MEMORY_TOP_K=5
